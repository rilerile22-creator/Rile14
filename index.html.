
<!doctype html>
<html lang="sr">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Stefanov 1. rođendan</title>

<style>
:root {
  --cream:#fff8e9;
  --honey:#e9ad43;
  --brown:#76513b;
  --pink:#f4d8d5;
  --sage:#cbd9bd;
}

* { box-sizing:border-box; }

body {
  margin:0;
  background:#f6ead7;
  color:var(--brown);
  font-family:Georgia,"Times New Roman",serif;
}

.scene {
  min-height:100svh;
  display:grid;
  place-items:center;
  padding:22px;
  overflow:hidden;
  background:
    radial-gradient(circle at 15% 15%,#fff 0 5%,transparent 26%),
    linear-gradient(145deg,#f9eddb,#f4dcd7 55%,#e8eddc);
}

/* PRVI KADAR - KOVERTA */

.intro {
  position:fixed;
  inset:0;
  z-index:20;
  display:grid;
  place-items:center;
  padding:22px;
  background:
    radial-gradient(circle at 15% 15%,#fff 0 5%,transparent 26%),
    linear-gradient(145deg,#f9eddb,#f4dcd7 55%,#e8eddc);
  transition:opacity .8s ease, visibility .8s ease;
}

.intro.hide {
  opacity:0;
  visibility:hidden;
  pointer-events:none;
}

.envelope-area {
  width:min(100%,430px);
  text-align:center;
}

.intro-title {
  color:#9b6b36;
  font-size:clamp(27px,7vw,38px);
  margin-bottom:12px;
  line-height:1.2;
}

.intro-subtitle {
  font:14px Arial,sans-serif;
  letter-spacing:2px;
  color:#a78355;
  margin-bottom:35px;
}

.envelope {
  position:relative;
  width:min(100%,340px);
  height:220px;
  margin:0 auto 32px;
  cursor:pointer;
  perspective:900px;
  filter:drop-shadow(0 15px 20px #8d6c4a30);
}

.envelope-back {
  position:absolute;
  inset:0;
  background:#e8c995;
  border-radius:8px;
}

.envelope-letter {
  position:absolute;
  left:9%;
  top:12%;
  width:82%;
  height:78%;
  background:#fffaf0;
  border:1px solid #ead7b5;
  display:grid;
  place-items:center;
  color:#a47743;
  font-size:22px;
  transition:transform 1s ease;
}

.envelope-letter span {
  font-size:38px;
  display:block;
  margin-top:8px;
}

.envelope-front {
  position:absolute;
  inset:0;
  background:#f0d8ad;
  clip-path:polygon(0 0,50% 55%,100% 0,100% 100%,0 100%);
}

.envelope-flap {
  position:absolute;
  inset:0;
  background:#e4bf83;
  clip-path:polygon(0 0,100% 0,50% 58%);
  transform-origin:top;
  transition:transform .9s ease;
  z-index:3;
}

.envelope-seal {
  position:absolute;
  z-index:4;
  left:50%;
  top:53%;
  transform:translate(-50%,-50%);
  width:54px;
  height:54px;
  border-radius:50%;
  display:grid;
  place-items:center;
  background:#c68e48;
  color:white;
  font-size:25px;
  box-shadow:0 3px 10px #76513b30;
  transition:opacity .3s;
}

.envelope.open .envelope-flap {
  transform:rotateX(180deg);
}

.envelope.open .envelope-letter {
  transform:translateY(-105px);
}

.envelope.open .envelope-seal {
  opacity:0;
}

.open-button {
  display:inline-block;
  border:0;
  border-radius:999px;
  padding:15px 28px;
  background:#dca443;
  color:#fff;
  font:600 15px Arial,sans-serif;
  box-shadow:0 5px 14px #b8832b30;
  cursor:pointer;
  animation:pulse 2s infinite;
}

.intro-note {
  margin-top:20px;
  font:12px Arial,sans-serif;
  color:#a78355;
}

@keyframes pulse {
  0%,100% { transform:scale(1); }
  50% { transform:scale(1.04); }
}

/* POSTOJEĆA POZIVNICA */

.card {
  width:min(100%,540px);
  min-height:720px;
  position:relative;
  border:1px solid #e6c99a;
  border-radius:28px;
  background:rgba(255,251,242,.88);
  box-shadow:0 18px 55px #8d6c4a25;
  overflow:hidden;
  padding:38px 25px 30px;
  text-align:center;
  opacity:0;
  transform:translateY(20px) scale(.97);
  transition:opacity .9s ease, transform .9s ease;
  pointer-events:none;
}

.card.visible {
  opacity:1;
  transform:translateY(0) scale(1);
  pointer-events:auto;
}

.sun {
  position:absolute;
  width:230px;
  height:230px;
  border-radius:50%;
  background:#f8df9e55;
  top:-100px;
  right:-80px;
}

.bee {
  position:absolute;
  font-size:26px;
  animation:bee 7s ease-in-out infinite;
  opacity:.85;
}

.bee.one {
  top:90px;
  left:10%;
  animation-delay:-2s;
}

.bee.two {
  top:240px;
  right:8%;
  animation-delay:-4s;
}

.leaves {
  position:absolute;
  bottom:-35px;
  left:-30px;
  font-size:100px;
  opacity:.16;
  transform:rotate(-25deg);
}

.kicker {
  letter-spacing:3px;
  text-transform:uppercase;
  font:12px Arial,sans-serif;
  color:#a78355;
  animation:rise .9s both;
}

h1 {
  font-size:clamp(32px,8vw,49px);
  line-height:1.05;
  margin:12px 0;
  color:#9b6b36;
  animation:rise 1s .2s both;
}

.subtitle {
  font-size:18px;
  margin:0 0 20px;
  animation:rise 1s .35s both;
}

.bear-wrap {
  height:225px;
  display:grid;
  place-items:center;
  position:relative;
  animation:rise 1s .5s both;
}

.bear {
  font-size:150px;
  filter:drop-shadow(0 8px 4px #8b674022);
  animation:bob 3.5s ease-in-out infinite;
  position:relative;
}

.honey {
  position:absolute;
  right:22%;
  bottom:35px;
  font-size:48px;
  animation:tilt 3s ease-in-out infinite;
}

.poem {
  font-size:20px;
  line-height:1.55;
  margin:8px auto 22px;
  max-width:390px;
  animation:rise 1s .7s both;
}

.details {
  display:flex;
  justify-content:center;
  gap:12px;
  flex-wrap:wrap;
  margin:22px 0 25px;
  animation:rise 1s .9s both;
}

.pill {
  background:#f7e7c4;
  border:1px solid #ecd29b;
  border-radius:999px;
  padding:12px 18px;
  font:14px Arial,sans-serif;
  color:#795632;
}

.buttons {
  display:flex;
  gap:10px;
  justify-content:center;
  flex-wrap:wrap;
  animation:rise 1s 1.1s both;
}

button,.linkbtn {
  border:0;
  border-radius:999px;
  padding:14px 20px;
  background:#dca443;
  color:#fff;
  font:600 14px Arial,sans-serif;
  text-decoration:none;
  cursor:pointer;
  box-shadow:0 5px 14px #b8832b25;
}

.secondary {
  background:#e8d7bd;
  color:#76513b;
}

.rsvp {
  display:none;
  text-align:left;
  margin:22px auto 0;
  max-width:390px;
  background:#fff8e9;
  border:1px solid #ead7b5;
  padding:18px;
  border-radius:18px;
}

.rsvp.show {
  display:block;
  animation:rise .35s both;
}

label {
  display:block;
  font:13px Arial,sans-serif;
  margin:10px 0 5px;
}

input {
  width:100%;
  padding:12px;
  border:1px solid #dfc8a2;
  border-radius:10px;
  background:#fff;
}

.submit {
  width:100%;
  margin-top:14px;
}

.status {
  text-align:center;
  font:13px Arial,sans-serif;
  margin-top:10px;
}

.foot {
  font:11px Arial,sans-serif;
  letter-spacing:1px;
  color:#b49a7b;
  margin-top:22px;
}

@keyframes rise {
  from { opacity:0; transform:translateY(18px); }
  to { opacity:1; transform:translateY(0); }
}

@keyframes bob {
  0%,100% { transform:translateY(0) rotate(-2deg); }
  50% { transform:translateY(-10px) rotate(2deg); }
}

@keyframes bee {
  0%,100% { transform:translate(0,0) rotate(0); }
  50% { transform:translate(22px,-14px) rotate(12deg); }
}

@keyframes tilt {
  0%,100% { transform:rotate(-8deg); }
  50% { transform:rotate(8deg); }
}

@media(max-width:420px) {
  .card {
    padding:30px 18px;
    min-height:690px;
  }

  .poem { font-size:18px; }
  .bear { font-size:130px; }
}

@media(prefers-reduced-motion:reduce) {
  *,*::before,*::after {
    animation:none!important;
  }
}
</style>
</head>

<body>

<!-- PRVI KADAR -->
<section class="intro" id="intro">
  <div class="envelope-area">
    <div class="intro-title">Stefanov 1. rođendan</div>
    <div class="intro-subtitle">.</div>

    <div class="envelope" id="envelope">
      <div class="envelope-back"></div>
      <div class="envelope-letter">
        Pozivnica
        <span>🧸</span>
      </div>
      <div class="envelope-front"></div>
      <div class="envelope-flap"></div>
      <div class="envelope-seal">♡</div>
    </div>

    <button class="open-button" id="openInvitation">
      Otvori pozivnicu
    </button>

    <div class="intro-note">
      Čekamo te da zajedno proslavimo!
    </div>
  </div>
</section>

<main class="scene">
<section class="card" id="invitation"
aria-label="Stefanova rođendanska pozivnica">

<div class="sun"></div>
<span class="bee one">🐝</span>
<span class="bee two">🐝</span>
<div class="leaves">🌿</div>

<div class="kicker">Jedan poseban dan</div>

<h1>Stefanov<br>1. rođendan</h1>

<p class="subtitle">
Pozivam te da zajedno proslavimo!
</p>

<div class="bear-wrap">
  <div class="bear">🧸</div>
  <div class="honey">🍯</div>
</div>

<p class="poem">
Pošto sam veseo i volim da slavim,<br>
rešio sam rođendan da pravim.<br>
Dođite da sa mnom podelite srećicu<br>
pa da zajedno ugasimo rođendansku svećicu!
</p>

<div class="details">
  <span class="pill">14. februar 2027.</span>
  <span class="pill">🕓 16:00</span>
</div>

<div class="buttons">
  <a class="linkbtn"
     href="https://maps.app.goo.gl/Eci1CRTTLnKPXS8q7"
     target="_blank"
     rel="noopener">
     📍 Klikni za lokaciju
  </a>

  <button id="toggle" type="button">
    💌 Potvrdi dolazak
  </button>
</div>

<form class="rsvp" id="rsvp">

  <label for="name">Ime i prezime</label>
  <input
    id="name"
    name="name"
    autocomplete="name"
    required
    placeholder="Kako da vas upišemo?">

  <label for="count">Broj osoba koje dolaze</label>
  <input
    id="count"
    name="count"
    type="number"
    min="1"
    max="30"
    value="1"
    required>

  <button class="submit" type="submit">
    Pošalji potvrdu
  </button>

  <div class="status" id="status" aria-live="polite"></div>

</form>

<div class="foot">
RADUJEM SE ŠTO ĆEMO SLAVITI ZAJEDNO ♡
</div>

</section>
</main>

<!-- Muzika: MP3 fajl treba da bude u istom folderu kao index.html -->
<audio id="birthdayMusic" src="muzika.mp3" preload="auto" loop></audio>

<script>
const intro = document.getElementById('intro');
const envelope = document.getElementById('envelope');
const openButton = document.getElementById('openInvitation');
const invitation = document.getElementById('invitation');
const music = document.getElementById('birthdayMusic');

let opened = false;

openButton.addEventListener('click', async () => {
  if (opened) return;
  opened = true;

  envelope.classList.add('open');
  openButton.textContent = '♡ Otvaramo pozivnicu...';

  // Pokretanje muzike nakon korisnikovog klika
  music.volume = 0.65;
  music.play().catch(() => {
    console.log('Muzika nije mogla da se pokrene.');
  });

  setTimeout(() => {
    intro.classList.add('hide');
    invitation.classList.add('visible');
  }, 1100);
});

const form = document.getElementById('rsvp');
const toggle = document.getElementById('toggle');
const status = document.getElementById('status');

toggle.addEventListener('click', () => {
  form.classList.toggle('show');

  if (form.classList.contains('show')) {
    document.getElementById('name').focus();
  }
});

// Google Apps Script URL
const SCRIPT_URL = 'https://script.google.com/macros/s/AKfycbyQRlELpTmxN5be11WxFsfIesGN1z9UNs1PMbrLsKRQCakGWkzvPh5fzDJsYa_oMOJ95w/exec';

form.addEventListener('submit', async e => {
  e.preventDefault();

  const name = document.getElementById('name').value.trim();
  const count = Number(document.getElementById('count').value);

  if (!name || count < 1 || count > 30) {
    status.textContent = 'Unesite ime i broj gostiju.';
    return;
  }

  status.textContent = 'Šaljem potvrdu…';

  try {
    await fetch(SCRIPT_URL, {
      method: 'POST',
      mode: 'no-cors',
      headers: {
        'Content-Type': 'text/plain;charset=UTF-8'
      },
      body: JSON.stringify({
        name: name,
        count: count
      })
    });

    status.textContent = 'Hvala! Potvrda je poslata ❤️';
    form.reset();

  } catch (err) {
    status.textContent = 'Slanje nije uspelo. Pokušajte ponovo.';
  }
});
</script>

</body>
</html
